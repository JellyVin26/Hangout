{
  "expo": {
    "name": "Hangout",
    "slug": "hangout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hangout",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "config": {
        "googleMapsApiKey": "AIzaSyDM6ouyFIwdhTFUre839qjODN95jYpt3v8"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F0522F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDM6ouyFIwdhTFUre839qjODN95jYpt3v8"
        }
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hangout uses your location to share live arrival progress with people in the selected hangout."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hangout needs photo access so you can share memories and photos in chat."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F0522F"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7F3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
